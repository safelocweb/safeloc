model Ocorrencia {
    id                      Int                  @id @default(autoincrement())
    cpfInquilino            String
    nomeInquilinoInformado  String
    dataNascimentoInquilino DateTime
    tipo                    TipoOcorrencia
    dataOcorrencia          DateTime
    situacaoAtual           SituacaoOcorrencia
    faixaValor              FaixaValorOcorrencia
    gravidade               GravidadeOcorrencia  @default(MEDIA)
    imobiliariaId           Int
    usuarioId               Int
    status                  StatusOcorrencia     @default(ATIVA)
    excluidoEm              DateTime?
    excluidoPorUsuarioId    Int?
    createdAt               DateTime             @default(now())

    imobiliaria       Imobiliaria @relation(fields: [imobiliariaId], references: [id])
    usuario           Usuario     @relation("OcorrenciaRegistradaPor", fields: [usuarioId], references: [id])
    excluidoPorUsuario Usuario?   @relation("OcorrenciaExcluidaPor", fields: [excluidoPorUsuarioId], references: [id])
    auditLogs         AuditLog[]
    contestacoes      Contestacao[]

    @@index([cpfInquilino])
    @@index([imobiliariaId])
    @@map("ocorrencias")
}
