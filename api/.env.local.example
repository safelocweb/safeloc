# Ambiente local. Copie para .env.local ou execute `npm run setup` na raiz.
PORT=9010

DATABASE_URL="postgresql://postgres:postgres@localhost:5443/risco_locaticio"
DIRECT_URL="postgresql://postgres:postgres@localhost:5443/risco_locaticio"

# Gere um valor exclusivo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="substitua-por-um-segredo-local-unico"
JWT_EXPIRES_IN="8h"

URL_FRONT_END="http://localhost:8010"
UPLOADS_DIR="./uploads"
TZ="America/Sao_Paulo"
